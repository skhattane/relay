#!/usr/bin/env bash
# relay-lead: starts the LEAD session of the current directory with the relay switched on.
#
#   relay-lead              resumes the lead session recorded for this directory
#   relay-lead <session id> resumes that session and records it as this directory's lead
#   relay-lead new          starts a fresh session (record it afterwards with `relay-lead <its id>`)
#
# The channel is a preview feature: it can only be switched on at launch, and asks for a confirmation at
# each start. The session's options are $RELAY_LEAD_ARGS (default: --dangerously-skip-permissions); the
# program run is $RELAY_CLI. The rooms the session listens to are those of this directory (relay join).
set -euo pipefail
DIR="${RELAY_CONFIG_DIR:-$HOME/.config/relay}"
LEADS="$DIR/leads.json"
CLI="${RELAY_CLI:-claude}"
ARGS="${RELAY_LEAD_ARGS---dangerously-skip-permissions}"
HERE=$(pwd -P)

# leads.json maps an absolute directory to a session id; python3 is already required by the relay itself.
leads() {
  python3 - "$LEADS" "$HERE" "$@" <<'EOF'
import json, os, sys
path, here = sys.argv[1], sys.argv[2]
try:
    with open(path, encoding="utf-8") as fh:
        leads = json.load(fh)
except (OSError, ValueError):
    leads = {}
if len(sys.argv) > 3:
    leads[here] = sys.argv[3]
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    with open(path + ".tmp", "w", encoding="utf-8") as fh:
        json.dump(leads, fh, indent=1)
    os.replace(path + ".tmp", path)
else:
    print(leads.get(here, ""))
EOF
}

case "${1:-}" in
  -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
  new) ID="" ;;
  "") ID=$(leads)
      [ -n "$ID" ] || { echo "relay-lead: no lead session recorded for $HERE — run: relay-lead <session id>   (or: relay-lead new)" >&2; exit 2; } ;;
  *) ID="$1"
     case "$ID" in *[!0-9a-f-]*|"") echo "relay-lead: a session id is hexadecimal with dashes" >&2; exit 2 ;; esac
     leads "$ID" ;;
esac

MOD="$DIR/mod"   # the /relay command, written by `relay install`
[ -f "$MOD/.claude-plugin/plugin.json" ] || MOD=""
# The channel names a server: this one, declared for this session only.
SERVER=$(python3 -c 'import json, sys; print(json.dumps({"mcpServers": {"relay": {"command": sys.argv[1], "args": ["serve"]}}}))' "$HOME/.local/bin/relay")
# shellcheck disable=SC2086 — the options are a list on purpose
exec env RELAY_LEAD=1 "$CLI" $ARGS ${ID:+--resume "$ID"} ${MOD:+--plugin-dir "$MOD"} \
  --mcp-config "$SERVER" --dangerously-load-development-channels server:relay
