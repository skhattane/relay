// relay, the hosted half. Deployed by ../deploy.sh, which passes ADMIN (the sha256 of the admin key).
// INVITE_SECONDS (optional) shortens the life of an invitation; it is left unset in production (24 h).
// OAUTH_REDIRECT_URIS (optional): the exact redirect URIs OAuth may return to, comma-separated; unset means the
// Claude apps' documented callback on claude.ai and on claude.com. ENROL_SECONDS, OAUTH_CODE_SECONDS and
// OAUTH_ACCESS_SECONDS shorten lifetimes for the tests only (600, 60 and 3600 by default).
// STATE_RATE (optional) changes the shared state's changes per seat per minute (30); the tests raise it.
// DOOR_KEEP_SECONDS and DOOR_KEEP_MAX (optional): how long, and how many, messages read by one client of a connector
// seat are kept for its other clients (86400 and 200 by default); the tests shorten them.
// PICTURE_RATE, PICTURE_ROOM_BYTES and LINK_MINUTE_MS (optional): pictures per sender per minute (6), bytes of pictures a
// room holds at once (33554432), and how long a link's « minute » lasts in milliseconds (60000); the tests change them.
{
  "name": "relay",
  "main": "relay.js",
  "compatibility_date": "2026-04-07",
  "workers_dev": true,
  "preview_urls": false,
  // Workers Logs ON: what the Worker writes (console.log) and one line per invocation are kept and can be read in
  // the dashboard (3 days on the free plan, 7 on paid). No URL of this Worker carries a secret, and the door's and
  // the OAuth endpoints' own lines never carry a token or a code.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
